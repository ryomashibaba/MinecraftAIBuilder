    "width": 48,
    "height": 80,
    "depth": 44
  },
  "intent": {
    "use": "Urban public halls at the first two levels; offices above; high restaurant at the crown.",
    "experience": "Public plazas rise from separate expansive halls into progressively stepped outdoor work gardens and a high restaurant panorama.",
    "massing": "Two broad civic halls support an occupiable tapering office tower with three deep west sky terraces. A folded street canopy leads to a broad glazed restaurant under a floating lens roof, not a facade applique.",
    "circulation": "Every room meets two landings beside an open-air two-lane eight-flight stair spine with recessed lateral lights."
  },
